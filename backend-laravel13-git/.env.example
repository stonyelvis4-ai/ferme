APP_NAME="FERM+ API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Abidjan

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
# DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ferm_plus
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
API_TOKEN_COOKIE=fermplus_api_token
API_TOKEN_COOKIE_SAME_SITE=lax
SANCTUM_EXPIRATION=120
FERM_ALLOW_PUBLIC_REGISTRATION=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Public OAuth Web client ID. Register each frontend URL as an authorized JavaScript origin in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_HOSTED_DOMAIN=

# Gemini powers the authenticated agricultural assistant. Keep the real key in
# the backend .env only; it must never be exposed through a VITE_ variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Only needed when PHP is blocked from reaching Google during local development.
GEMINI_LOCAL_PROXY_URL=
GEMINI_LOCAL_PROXY_TOKEN=

VITE_APP_NAME="${APP_NAME}"
